# Copy this file to .env.local and fill in the values.
# Supabase dashboard -> Project Settings -> API

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server only. NEVER expose this in browser code or commit it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Your site address (use http://localhost:3000 while developing)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Optional emails (Phase 5). Leave empty to turn emails off. ----
# Free key from https://resend.com
RESEND_API_KEY=
# Where YOU get alerts (new order, payment to check, review, custom request)
OWNER_EMAIL=
# Sender, e.g. MUSE <orders@yourdomain.com>. Needs a domain verified in Resend.
# Empty = Resend's test sender (delivers only to the email you signed up to Resend with).
EMAIL_FROM=
